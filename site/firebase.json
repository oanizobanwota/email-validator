{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/downloads/**",
        "headers": [
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/downloads/**/*.exe",
        "headers": [{ "key": "Content-Type", "value": "application/vnd.microsoft.portable-executable" }]
      },
      {
        "source": "/downloads/**/*.dmg",
        "headers": [{ "key": "Content-Type", "value": "application/x-apple-diskimage" }]
      }
    ]
  }
}
