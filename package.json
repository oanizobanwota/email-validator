{
  "name": "email-validator-desktop",
  "productName": "Email Validator",
  "version": "1.1.1",
  "description": "Desktop app that checks whether email addresses are well-formed and actually exist (MX + SMTP mailbox probe).",
  "main": "src/main/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node src/main/cli.js",
    "test": "node src/main/validator.test.js",
    "dist": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --mac --win --x64 --arm64 --publish never",
    "web": "node src/web/server.js",
    "license": "node tools/license.js",
    "users": "node src/web/users.js"
  },
  "build": {
    "appId": "com.otawiz.emailvalidator",
    "productName": "Email Validator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "artifactName": "Email-Validator-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Email-Validator-Setup-${version}-${arch}.${ext}",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "Email-Validator-Portable-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright \u00a9 2026 OtaWIZ"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "author": {
    "name": "OtaWIZ",
    "email": "oanizobanwota@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oanizobanwota/email-validator.git"
  },
  "homepage": "https://scuntore.com"
}
